---
import wash from "../../assets/wash.jpg";
import logowhite from "../../assets/logo-white.svg";
const { background } = Astro.props;
---

<section class="grid">
	<div id="index-header" class="flex">
		<a href="artist-statement">artist statement</a>
		<a href="artist-statement">'i am not a brand'</a>
	</div>
	<div id="div1" class="grid">
		<h1>contact@blaatsofie.com</h1>
		<img id="logo" src={logowhite.src} alt="" />
	</div>
	<div id="statement" class="grid">
		<a class="grid" href="artist-statement">
			<img src={wash.src} alt="" />
		</a>
	</div>
</section>

<style>
	section {
		background-color: var(--blaat);
		width: 100vw;
		height: 100vh;
		margin-end: -5px;
	}

	a {
		color: var(--white);
		font-weight: 100;
		text-decoration: none;
		font-size: 12px;
	}

	#index-header {
		grid-column: 1/2;
		grid-row: 1/2;
		justify-self: center;
		gap: 150px;
		height: 20px;
		a {
			opacity: 30%;
		}
		a:hover {
			opacity: 100%;
		}
	}

	h1 {
		grid-column: 1/2;
		grid-row: 1/2;
		font-size: 10px;
	}

	#div1 {
		grid-column: 1/2;
		grid-row: 1/2;
		place-self: end;
		width: 100vw;
		height: auto;
		margin-bottom: 15vh;
		h1 {
			grid-column: 1/2;
			grid-row: 1/2;
			color: var(--white);
			font-size: 20px;
			letter-spacing: -1.8px;
			font-weight: 100;
		}
		#logo {
			grid-column: 1/2;
			grid-row: 2/3;
		}
	}

	#statement {
		grid-column: 1/2;
		grid-row: 1/2;
		width: 200px;
		height: 225px;
		a {
			grid-column: 1/2;
			grid-row: 1/2;
			text-decoration: none;
			img {
				grid-column: 1/2;
				grid-row: 1/2;
				z-index: 10;
				place-self: center;
				width: 150px;
				height: 225px;
			}
		}
		a:hover {
			opacity: 50%;
		}
	}

	#statement {
		animation-name: statement-img;
		animation-duration: 20s;
		animation-timing-function: linear;
		animation-iteration-count: infinite;
	}
	@keyframes statement-img {
		0% {
			translate: 20% 0;
		}
		25% {
			translate: 108% 120%;
		}
		50% {
			translate: 80% 210%;
		}
		75% {
			translate: -13% 70%;
		}
		100% {
			translate: 20% 0;
		}
	}

	@media (min-width: 600px) {
		#index-header {
			grid-column: 1/2;
			grid-row: 1/2;
			justify-self: start;
			gap: 150px;
			margin-left: 30px;
			a {
				opacity: 30%;
			}
		}

		#div1 {
			margin-bottom: 1vh;
			h1 {
				font-size: 20px;
				letter-spacing: -2.2px;
				margin-left: 50%;
				margin-bottom: 13%;
			}
		}

		#statement {
			animation-duration: 50s;
		}

		@keyframes statement-img {
			0% {
				translate: 20vw 0;
			}
			25% {
				translate: 88vw 25vh;
			}
			50% {
				translate: 50vw 68vh;
			}
			75% {
				translate: -2vw 30vh;
			}
			100% {
				translate: 20vw 0;
			}
		}
	}
</style>
